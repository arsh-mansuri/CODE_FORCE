# ==============================================================================
# Environment Variables Template
# Copy this file to .env and configure your local or production keys.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database URL
# Default is local zero-config SQLite:
DATABASE_URL=sqlite:///./propvibe.db
# For PostgreSQL / Supabase in production:
# DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# AI & LLM Inference APIs (Optional for live LLM mode, fallback mock available)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Security & CORS
SECRET_KEY=generate_a_secure_random_key_for_jwt_and_sessions
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://propvibe.vercel.app
