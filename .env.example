# ==============================================================================
# Environment Variables Template
# Copy this file to backend/.env. No external API key is needed for the MVP.
# ==============================================================================

# Server hints (pass --host/--port to uvicorn explicitly)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database URL
# Default is local zero-config SQLite:
DATABASE_URL=sqlite:///./propvibe.db
# For PostgreSQL / Supabase in production:
# Install psycopg[binary] separately to use PostgreSQL; SQLite is the tested demo default.
# DATABASE_URL=postgresql+psycopg://postgres:your_password@db.supabase.co:5432/postgres

# Reserved for future live LLM integration. The MVP lease reviewer is explicitly
# labelled local_heuristic and does not use these values.
GEMINI_API_KEY=
GROQ_API_KEY=

# Security & CORS
# Random opaque bearer sessions are stored as SHA-256 hashes, not signed JWTs.
SESSION_DAYS=7
# Optional absolute path for durable media storage. Defaults to backend/uploads.
# MEDIA_ROOT=/absolute/path/to/propvibe-uploads
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://propvibe.vercel.app
